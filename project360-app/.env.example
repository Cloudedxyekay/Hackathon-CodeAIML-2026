# Optional. Local extraction works without these settings.
# Copy this file to .env and supply your key on the backend only.
OPENAI_API_KEY=
NOVA_AI_MODEL=gpt-4.1-mini

# Ask NOVA uses Ollama when a model is configured. Install it with:
# ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=45
