{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python -m pip install -r project360-app/requirements.txt"
  },
  "deploy": {
    "startCommand": "python -m uvicorn server.main:app --app-dir project360-app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120
  }
}
